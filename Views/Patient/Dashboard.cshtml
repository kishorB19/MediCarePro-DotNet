@model HMS.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Patient Dashboard";
}

<h2 style="font-size: 1.5rem; font-weight: 300; margin-bottom: 24px;">Welcome, <span style="font-weight: 600; color: var(--primary-light);">@ViewBag.PatientName</span></h2>

<div class="stats-grid">
    <div class="stat-card purple">
        <div class="stat-icon purple">📋</div>
        <div class="stat-value">@Model.TotalAppointments</div>
        <div class="stat-label">Total Appointments</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon orange">⏳</div>
        <div class="stat-value">@Model.PendingAppointments</div>
        <div class="stat-label">Pending</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon green">✓</div>
        <div class="stat-value">@Model.CompletedAppointments</div>
        <div class="stat-label">Completed</div>
    </div>
    <div class="stat-card cyan">
        <div class="stat-icon cyan">📅</div>
        <div class="stat-value">@Model.TodayAppointments</div>
        <div class="stat-label">Today</div>
    </div>
</div>

<div class="d-flex gap-3 mb-6">
    <a href="@Url.Action("Doctors", "Patient")" class="btn btn-primary">🔍 Find a Doctor</a>
    <a href="@Url.Action("Prescriptions", "Patient")" class="btn btn-secondary">💊 My Prescriptions</a>
</div>

<div class="card">
    <div class="card-header">
        <h3>Recent Appointments</h3>
        <a href="@Url.Action("Appointments", "Patient")" class="btn btn-sm btn-outline">View All</a>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Doctor</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentAppointments.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted" style="padding:40px;">No appointments yet. Browse doctors to book one!</td></tr>
                }
                @foreach (var a in Model.RecentAppointments)
                {
                    <tr>
                        <td style="color: var(--text-primary); font-weight: 500;">@a.Doctor?.User?.FullName</td>
                        <td>@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                        <td>@a.TimeSlot</td>
                        <td><span class="badge badge-@a.Status.ToString().ToLower()">@a.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
