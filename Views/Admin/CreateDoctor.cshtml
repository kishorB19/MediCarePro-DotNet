@model HMS.Models.ViewModels.CreateDoctorViewModel
@{
    ViewData["Title"] = "Add New Doctor";
}

<div style="max-width: 700px;">
    <div class="card">
        <div class="card-header">
            <h3>Doctor Information</h3>
        </div>
        <div class="card-body">
            <form asp-action="CreateDoctor" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Dr. Name" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="doctor@hms.com" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" placeholder="Min 6 characters" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Specialization" class="form-label">Specialization</label>
                        <input asp-for="Specialization" class="form-control" placeholder="Cardiology" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Qualification" class="form-label">Qualification</label>
                        <input asp-for="Qualification" class="form-control" placeholder="MBBS, MD" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ExperienceYears" class="form-label">Experience (Years)</label>
                        <input asp-for="ExperienceYears" class="form-control" type="number" min="0" />
                    </div>
                    <div class="form-group">
                        <label asp-for="ConsultationFee" class="form-label">Consultation Fee (₹)</label>
                        <input asp-for="ConsultationFee" class="form-control" type="number" min="0" step="50" />
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Bio" class="form-label">Bio</label>
                    <textarea asp-for="Bio" class="form-control" placeholder="Brief description about the doctor..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Doctor</button>
                    <a href="@Url.Action("Doctors", "Admin")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
