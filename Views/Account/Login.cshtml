@model HMS.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Welcome Back</h2>
            <p>Sign in to your MediCare Pro account</p>
        </div>

        <form id="loginForm" asp-action="Login" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Enter your password" type="password" />
            </div>

            <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                <input asp-for="RememberMe" type="checkbox" id="RememberMe" />
                <label for="RememberMe" class="form-label mb-0" style="margin-bottom:0">Remember me</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>

        <div class="demo-login-section" style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); text-align: center;">
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 12px; font-weight: 500;">Demo Quick Login</p>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                <button type="button" class="btn btn-secondary btn-sm" onclick="quickLogin('admin@hms.com', 'Admin@123')" style="padding: 10px 4px; font-size: 0.8rem;">Admin</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="quickLogin('dr.sharma@hms.com', 'Doctor@123')" style="padding: 10px 4px; font-size: 0.8rem;">Doctor</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="quickLogin('rahul@gmail.com', 'Patient@123')" style="padding: 10px 4px; font-size: 0.8rem;">Patient</button>
            </div>
        </div>

        <script>
            function quickLogin(email, password) {
                document.getElementById('Email').value = email;
                document.getElementById('Password').value = password;
                document.getElementById('loginForm').submit();
            }
        </script>

        <div class="auth-footer">
            Don't have an account? <a href="@Url.Action("Register", "Account")">Create one</a>
        </div>
    </div>
</div>
